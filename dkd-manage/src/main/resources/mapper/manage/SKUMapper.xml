<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dkd.manage.mapper.SKUMapper">

    <!-- 数据库列 → Java 字段 的对照表 -->
    <resultMap type="SKU" id="SkuResult">
        <id     property="skuId"      column="sku_id"      />
        <result property="skuName"    column="sku_name"    />
        <result property="brandName"  column="brand_name"  />
        <result property="unit"       column="unit"        />
        <result property="price"      column="price"       />
        <result property="skuImage"   column="sku_image"   />
        <result property="status"     column="status"      />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>

    <!-- 公共查询列，抽出来复用 -->
    <sql id="selectSkuVo">
        select sku_id, sku_name, brand_name, unit, price, sku_image, status,
               create_by, create_time, update_by, update_time, remark
        from tb_sku
    </sql>

    <!-- 列表：SKUMapper.findAllSKU() 没有参数，所以这里不加动态条件 -->
    <select id="findAllSKU" resultMap="SkuResult">
        <include refid="selectSkuVo"/>
        order by sku_id desc
    </select>

    <!-- 按主键查一条 -->
    <select id="findSKUById" parameterType="Long" resultMap="SkuResult">
        <include refid="selectSkuVo"/>
        where sku_id = #{skuId}
    </select>

    <!-- 新增：useGeneratedKeys 把数据库生成的自增主键回填到 sku.skuId -->
    <insert id="add" parameterType="SKU" useGeneratedKeys="true" keyProperty="skuId">
        insert into tb_sku(
            <if test="skuName != null and skuName != ''">sku_name,</if>
            <if test="brandName != null and brandName != ''">brand_name,</if>
            <if test="unit != null and unit != ''">unit,</if>
            <if test="price != null">price,</if>
            <if test="skuImage != null and skuImage != ''">sku_image,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="skuName != null and skuName != ''">#{skuName},</if>
            <if test="brandName != null and brandName != ''">#{brandName},</if>
            <if test="unit != null and unit != ''">#{unit},</if>
            <if test="price != null">#{price},</if>
            <if test="skuImage != null and skuImage != ''">#{skuImage},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <!-- 修改：<set> 会自动去掉多余的逗号 -->
    <update id="update" parameterType="SKU">
        update tb_sku
        <set>
            <if test="skuName != null and skuName != ''">sku_name = #{skuName},</if>
            <if test="brandName != null and brandName != ''">brand_name = #{brandName},</if>
            <if test="unit != null and unit != ''">unit = #{unit},</if>
            <if test="price != null">price = #{price},</if>
            <if test="skuImage != null and skuImage != ''">sku_image = #{skuImage},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where sku_id = #{skuId}
    </update>

    <!-- 批量删除：拼成 in (1,2,3) -->
    <delete id="delete" parameterType="Long">
        delete from tb_sku where sku_id in
        <foreach collection="array" item="skuId" open="(" separator="," close=")">
            #{skuId}
        </foreach>
    </delete>

</mapper>
